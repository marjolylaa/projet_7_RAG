# Normalisation automatique des fins de ligne
* text=auto eol=lf

# Fichiers sources texte
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Fichiers binaires (images, documents)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
